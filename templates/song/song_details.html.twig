{% extends 'base.html.twig' %}

{# {% block title %}{{song.title}}{% endblock %} #}

{% block body %}
<section class="container row d-flex justify-content-center mx-auto mt-3">

    <div class="col-11 col-lg-9 mt-5 row">
        <div class="row">
            <h1 class="text-center fw-bolder col offset-1">{{song.title}}</h1>
            <a href="{{ path('app_song') }}" class="text-center text-decoration-none m-auto col">
                <button type="button" class="btn btn-sm btn-primary rounded">Retour à la page chants</button>
            </a>
        <p class="text-center mt-5">{{song.description}}</p>

        <div class="d-flex justify-content-center flex-column mt-5 mx-auto">
            {% for voice in voices %}
                <h2 class="row mx-auto mt-3">{{ voice.voiceType }}</h2>

                {% if voice.fileType == "mp3" %}
                    <audio class="row mx-auto w-50"
                        controls
                        src="{{ asset('uploads/voices/') ~  voice.fileName ~ '.mp3' }}" type="audio/mp3">
                        <a href="{{ asset('uploads/voices/') ~  voice.fileName ~ ".mp3" }}">
                        Download audio
                        </a>
                    </audio>
                {% elseif voice.fileType == "MP3" %}
                    <audio class="row mx-auto w-50"
                        controls
                        src="{{ asset('uploads/voices/') ~  voice.fileName ~ '.MP3' }}" type="audio/mp3">
                        <a href="{{ asset('uploads/voices/') ~  voice.fileName ~ ".MP3" }}">
                        Download audio
                        </a>
                    </audio>
                {% elseif voice.fileType == "m4a" %}
                    <audio class="row mx-auto w-50"
                        controls
                        src="{{ asset('uploads/voices/') ~  voice.fileName ~ '.m4a' }}" type="audio/m4a">
                        <a href="{{ asset('uploads/voices/') ~  voice.fileName ~ ".m4a" }}">
                        Download audio
                        </a>
                    </audio>
                {% endif %}
            {% endfor %}
        </div>

        <div class="d-flex mt-5 mx-auto h-auto object-fit-contain">

            {% for text in texts %}

                <figure class="w-75 d-flex text mx-auto p-0 justify-content-center">
                    {% if text.fileType == "pdf" %}
                        <iframe class="mx-auto p-0" id="text" src="{{ asset('uploads/texts/') ~  text.fileName ~ ".pdf" }}" type="application/pdf"></iframe>
                    {% elseif text.fileType == "jpg" %}
                        <img class="mx-auto" id="text" src="{{ asset('uploads/texts/') ~  text.fileName ~ ".jpg" }}" />
                    {% endif %}
                </figure>

            {% endfor %}
        </div>
        <div>
        </div>


        <div class="containerVideo">
            <div class="d-flex justify-content-center mt-5 mx-auto divVideo">
                <figure class="video mx-auto">
                    {{ song.urlVideo | raw }}
                </figure>
            </div>
        </div>

    </div>

</section>

{% endblock %}
