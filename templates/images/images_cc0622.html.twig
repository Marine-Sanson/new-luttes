{% extends 'base.html.twig' %}

{% block title %}Luttes Enchantées - Images - Chorales Aux Champs{% endblock %}

{% block body %}

        <section class="container row d-flex justify-content-center my-3 mx-auto">
			
			<div class="col-11 col-lg-9 row mt-5">
				<h1 class="text-center fw-bolder fs-2 mt-3">Chorales Aux Champs - 11/06/2022</h1>
                <div class="row text-right">
                    <a href="{{ path('app_images_concerts') }}" class="text-end text-decoration-none m-auto col">
                    <button type="button" class="btn btn-sm btn-primary rounded">Retour</button>
                    </a>
                </div>
            </div>

			<div class="col-11 col-lg-9 row mt-5">
                <h2 class="text-center fs-4 mt-3">Les vidéos de notre tout premier concert !!!</h2>
            </div>

			<div class="col-11 col-lg-9 row mt-5">
                <a href="{{ path('app_videoConcertPortrait', { videoId: 1 }) }}" class="text-center text-decoration-none col-md my-auto mx-auto">
                    <button type="button" class="btn btn-sm btn-primary rounded my-2 mx-auto">Le jeu de la marelle</button>
                </a>
                <a href="{{ path('app_videoConcertPortrait', { videoId: 2 }) }}" class="text-center text-decoration-none col-md my-auto mx-auto">
