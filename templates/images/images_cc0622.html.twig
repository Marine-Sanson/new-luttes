                </a>
                <a href="{{ path('app_videoConcertPortrait', { videoId: 3 }) }}" class="text-center text-decoration-none col-md my-auto mx-auto">
                    <button type="button" class="btn btn-sm btn-primary rounded my-2 mx-auto">My eyes</button>
                </a>
                <a href="{{ path('app_videoConcertPortrait', { videoId: 4 }) }}" class="text-center text-decoration-none col-md my-auto mx-auto">
                    <button type="button" class="btn btn-sm btn-primary rounded my-2 mx-auto">Le Otto Ore</button>
                </a>
                <a href="{{ path('app_videoConcertPortrait', { videoId: 5 }) }}" class="text-center text-decoration-none col-md my-auto mx-auto">
                    <button type="button" class="btn btn-sm btn-primary rounded my-2 mx-auto">Duas Cirandas</button>
                </a>
            </div>

		</section>

{% endblock %}
