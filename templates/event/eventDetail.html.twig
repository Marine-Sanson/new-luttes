{% extends 'base.html.twig' %}

{% block title %}Luttes Enchantées - Agenda{% endblock %}

{% block body %}
	<section class="container row d-flex justify-content-center agenda">
		
		<div class="col-lg-9 col-12 row">

			<h1 class="text-center fw-bolder mt-5">{{ event.eventCategory }} du {{ event.date }}</h1>

			<h2 class="mt-5 text-center">Infos internes : </h2>

			<p class="text-center">{{ event.privateDetails }}</p>

			<h2 class="mt-5 text-center">Infos publiques : </h2>

			<p class="text-center">{{ event.publicDetails }}</p>

			<h2 class="mt-5 text-center">Participantes :</h2>

			<h3 class="mt-2 text-center">Présentes : {{ event.participationOui|length }}</h3>

			<ul class="deck mt-2 mx-5">
				{% for name in event.participationOui|sort %}
			
					<li class="mb-2">{{name}}</li>
				{% endfor %}
			</ul>

			<h3 class="mt-2 text-center">Absentes : {{ event.participationNon|length }}</h3>

			<ul class="deck mt-2 mx-5">
				{% for name in event.participationNon|sort  %}
			
					<li class="mb-2">{{name}}</li>
				{% endfor %}
			</ul>

			<h3 class="mt-2 text-center">Ne savent pas : {{ event.participationNsp|length }}</h3>

			<ul class="deck mt-2 mx-5">
				{% for name in event.participationNsp|sort %}
			
					<li class="mb-2">{{name}}</li>
				{% endfor %}
			</ul>

			<h3 class="mt-2 text-center">Non répondu : {{ event.participationPasrep|length }}</h3>

			<ul class="deck mt-2 mx-5">
				{% for name in event.participationPasrep|sort %}
			
					<li class="mb-2">{{name}}</li>
				{% endfor %}
			</ul>
		
		</div>

	</section>

{% endblock %}
